# --- ETAPA 1: Construcción (Node.js) ---
# Usamos la versión 20 de Node (recomendada para las versiones más recientes de Angular)
FROM node:20-alpine AS build

# Creamos el directorio de trabajo
WORKDIR /app

# Copiamos primero los archivos de dependencias (buena práctica para aprovechar la caché de Docker)
COPY package*.json ./

# Instalamos las dependencias
RUN npm install

# Copiamos todo el código fuente del proyecto
COPY . .

# Compilamos la aplicación de Angular (esto ejecutará "ng build")
RUN npm run build -- --configuration production

# --- ETAPA 2: Servidor Web (Nginx) ---
# Usamos un servidor Nginx muy ligero para servir los archivos estáticos
FROM nginx:alpine

# Configuramos Nginx para que soporte el enrutamiento de Angular (SPAs)
# Redirige cualquier ruta no encontrada al index.html
RUN rm /etc/nginx/conf.d/default.conf
RUN echo "server { \
    listen 80; \
    location / { \
        root /usr/share/nginx/html; \
        index index.html index.htm; \
        try_files \$uri \$uri/ /index.html; \
    } \
}" > /etc/nginx/conf.d/default.conf

# Copiamos los archivos compilados desde la Etapa 1.
# El nuevo builder de Angular guarda los archivos en la subcarpeta /browser
COPY --from=build /app/dist/organiflow-frontend /usr/share/nginx/html

# Exponemos el puerto 80 (el puerto web estándar)
EXPOSE 80

# Comando para iniciar Nginx
CMD ["nginx", "-g", "daemon off;"]
